# Copy to .env and fill in what you have. Everything is optional:
# with no keys the app runs on the seeded demo catalog in quick-search mode.

# --- LLM (Gemini) ---------------------------------------------------------
# Free key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Main model + fallbacks tried in order when a model is overloaded ("-latest" aliases track Google's current models)
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# --- Live prices ------------------------------------------------------------
# Google Shopping India via SerpApi: covers Croma, Reliance Digital, Vijay Sales,
# Tata CLiQ, Nykaa, AJIO, JioMart, brand stores and more in one call.
SERPAPI_KEY=
# The first time a live product is analysed, load ~12 months of real per-store price history
# from Google Shopping (1 SerpApi search per product, at most once per product)
HISTORY_BACKFILL_ENABLED=true
# SerpApi searches per month reserved for backfills (the free plan has 250 in total)
HISTORY_BACKFILL_MONTHLY_LIMIT=100
# Tracked live products re-priced per day at 06:00 IST (1 SerpApi search each; most recently searched first)
PRICE_REFRESH_DAILY_LIMIT=2

# Amazon PA-API 5.0 (needs an Associates account with 3 sales in 180 days)
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=

# Flipkart Affiliate API
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# Direct store scrapers (Amazon/Flipkart/Myntra) when no API keys are set.
# Stores block scrapers and their terms forbid it: local development only.
ENABLE_SCRAPERS=false

# Seeded sample products: auto = only while no live price source (SerpApi/Amazon/Flipkart/scrapers)
# is configured; true = always (shown separately, never mixed with real prices); false = never
DEMO_CATALOG=auto

# --- Infrastructure -----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smartdeal
REDIS_URL=redis://localhost:6379/0

# --- App ----------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Frontend (baked in at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
